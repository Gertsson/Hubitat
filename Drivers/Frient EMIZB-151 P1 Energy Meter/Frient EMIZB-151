def parse(String description) {
    def descMap = zigbee.parseDescriptionAsMap(description)
    if (!descMap) {
        if (debugLogging) log.debug "EMIZB-151: Ignored raw mesh traffic payload description map is empty."
        return
    }

    def cluster = descMap.clusterId ?: descMap.cluster
    def attrId  = descMap.attrId
    def value   = descMap.value

    if (!value || value == "null") {
        if (debugLogging) log.debug "EMIZB-151 Parse Alert: Received payload frame containing null string or value placeholder fields."
        return
    }

    if (debugLogging) {
        log.debug "EMIZB-151 Raw Parse Incoming Frame: cluster=${cluster}, attr=${attrId}, value=${value}"
    }

    // === METERING CLUSTER (0x0702) ===
    if (cluster == "0702" || cluster == "702") {
        if (attrId == "0000") {
            long rawVal = Long.parseLong(value, 16)
            double kwh = rawVal / 1000.0
            if (debugLogging) log.debug "EMIZB-151 Debug: Processed Cumulative Active Energy (Import) = ${kwh} kWh"
            sendEvent(name: "energy", value: kwh, unit: "kWh")
        } 
        if (attrId == "0400") {
            long rawVal = Long.parseLong(value, 16)
            double freq = rawVal / 10.0
            if (debugLogging) log.debug "EMIZB-151 Debug: Processed Cumulative Powerline Frequency = ${freq} Hz"
            sendEvent(name: "frequency", value: freq, unit: "Hz")
        } 
        else {
            if (debugLogging) log.debug "EMIZB-151 Debug: Unhandled 0x0702 Cluster Attribute encountered: Attr ID = ${attrId} with Hex value = ${value}"
        }
    }
    // === ELECTRICAL MEASUREMENT CLUSTER (0x0B04) ===
    else if (cluster == "0B04" || cluster == "B04") {
        long rawLong = Long.parseLong(value, 16)
        int rawVal = rawLong.intValue()
        
        // 16-bit signed integer conversion block for Phase attributes (INT16 / Two's Complement)
        int shortVal = rawVal & 0xFFFF
        if (shortVal > 0x7FFF) {
            shortVal -= 0x10000
        }
      
         switch(attrId) {
            case "0304": // Total Active Power (32-bit signed)
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Aggregated Active Power = ${rawVal} W"
                sendEvent(name: "power", value: rawVal, unit: "W")
                break
            case "0305": // Total Reactive Power (32-bit signed)
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Aggregated Reactive Power = ${rawVal} VAr"
                sendEvent(name: "reactivePower", value: rawVal, unit: "VAr")
                break
                
            // === VOLTAGES (DSMR Standard Scaled to 0.1V) ===
            case "0505": 
                double vA = rawVal / 10.0
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase A (L1) Voltage = ${vA} V"
                sendEvent(name: "voltageA", value: vA, unit: "V")
                break
            case "0905": 
                double vB = rawVal / 10.0
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase B (L2) Voltage = ${vB} V"
                sendEvent(name: "voltageB", value: vB, unit: "V")
                break
            case "0A05": 
                double vC = rawVal / 10.0
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase C (L3) Voltage = ${vC} V"
                sendEvent(name: "voltageC", value: vC, unit: "V")
                break
            
            // === CURRENTS (DSMR Standard Scaled to 0.1A) ===
            case "0508": 
                double cA = rawVal / 10.0
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase A (L1) Current = ${cA} A"
                sendEvent(name: "currentA", value: cA, unit: "A")
                break
            case "0908": 
                double cB = rawVal / 10.0
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase B (L2) Current = ${cB} A"
                sendEvent(name: "currentB", value: cB, unit: "A")
                break
            case "0A08": 
                double cC = rawVal / 10.0
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase C (L3) Current = ${cC} A"
                sendEvent(name: "currentC", value: cC, unit: "A")
                break
            
            // === ACTIVE POWER PER PHASE (16-bit Signed) ===
            case "050B": 
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase A (L1) Active Power = ${shortVal} W"
                sendEvent(name: "powerA", value: shortVal, unit: "W")
                break
            case "090B": 
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase B (L2) Active Power = ${shortVal} W"
                sendEvent(name: "powerB", value: shortVal, unit: "W")
                break
            case "0A0B": 
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase C (L3) Active Power = ${shortVal} W"
                sendEvent(name: "powerC", value: shortVal, unit: "W")
                break
        
        
            // === REACTIVE POWER PER PHASE (16-bit Signed) ===
            case "050E": 
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase A (L1) Reactive Power = ${shortVal} VAr"
                sendEvent(name: "reactivePowerA", value: shortVal, unit: "VAr")
                break
            case "090E": 
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase B (L2) Reactive Power = ${shortVal} VAr"
                sendEvent(name: "reactivePowerB", value: shortVal, unit: "VAr")
                break
            case "0A0E": 
                if (debugLogging) log.debug "EMIZB-151 Debug: Processed Phase C (L3) Reactive Power = ${shortVal} VAr"
                sendEvent(name: "reactivePowerC", value: shortVal, unit: "VAr")
                break 
             
			default:
                if (debugLogging) log.debug "EMIZB-151 Debug: Unhandled 0x0B04 Cluster Attribute map index caught: Attr ID = ${attrId} with Hex value = ${value}"
                break
        }
    }
}


